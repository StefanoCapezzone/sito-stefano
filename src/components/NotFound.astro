---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navLinks, t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Niente Breadcrumb, a differenza di ogni altra pagina: il breadcrumb dichiara
// una posizione nella gerarchia del sito, e questa pagina risponde a indirizzi
// che nella gerarchia non stanno.
const links = navLinks(lang);
---

<BaseLayout
  title={t(lang, 'notFound.title')}
  description={t(lang, 'notFound.description')}
  lang={lang}
  noindex
>
  <div class="py-16 lg:py-24">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-6xl lg:text-7xl font-bold text-ibm-blue-30">404</p>

      <h1 class="text-3xl lg:text-4xl font-bold text-ibm-blue-90 mt-4 mb-4">
        {t(lang, 'notFound.title')}
      </h1>

      <p class="text-lg text-ibm-blue-70">
        {t(lang, 'notFound.message')}
      </p>

      <nav class="mt-10" aria-label={t(lang, 'notFound.links')}>
        <p class="text-sm font-medium text-ibm-blue-50 mb-3">
          {t(lang, 'notFound.links')}
        </p>
        <ul class="flex flex-wrap gap-3">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block px-4 py-2 rounded-lg bg-ibm-blue-10 text-ibm-blue-70 font-medium hover:bg-ibm-blue-20 hover:text-ibm-blue-60 transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</BaseLayout>
