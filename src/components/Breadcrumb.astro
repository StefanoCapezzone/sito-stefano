---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  lang?: 'it' | 'en';
}

const { items, lang = 'it' } = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    ...(item.href ? { "item": new URL(item.href, Astro.site).href } : {}),
  })),
};
---

<nav aria-label={lang === 'it' ? 'Breadcrumb' : 'Breadcrumb'} class="mb-8">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-ibm-blue-50">
    {items.map((item, index) => (
      <li class="flex items-center">
        {index > 0 && (
          <svg class="w-4 h-4 mx-1 text-ibm-blue-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {item.href ? (
          <a href={item.href} class="hover:text-ibm-blue-60 transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-ibm-blue-70 font-medium truncate max-w-[200px] sm:max-w-none">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
