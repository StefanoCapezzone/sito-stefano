---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { t, formatDate } from '../../../i18n/utils';

const lang = 'it';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return data.lang === 'it' && !data.draft;
  });

  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^(it|en)\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'it' && !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .filter((p) => p.data.tags?.some((tag) => post.data.tags?.includes(tag)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.image ? new URL(post.data.image, Astro.site).href : undefined,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "author": { "@id": "https://stefano.capezzone.it/#person" },
  "publisher": { "@id": "https://stefano.capezzone.it/#person" },
  "mainEntityOfPage": Astro.url.href,
  "inLanguage": "it-IT"
};

const breadcrumbItems = [
  { label: 'Home', href: '/it/' },
  { label: 'Blog', href: '/it/blog' },
  { label: post.data.title },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  ogImage={post.data.ogImage}
  lang={lang}
  jsonLd={articleSchema}
  ogType="article"
  datePublished={post.data.pubDate.toISOString()}
  dateModified={(post.data.updatedDate || post.data.pubDate).toISOString()}
  articleMeta={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: (post.data.updatedDate || post.data.pubDate).toISOString(),
    author: "https://stefano.capezzone.it/it/bio",
    tags: post.data.tags,
  }}
>
  <article class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} lang={lang} />

      <!-- Header -->
      <header class="mb-12">
        <div class="flex items-center gap-4 text-sm text-ibm-blue-50 mb-4">
          <a href="/it/bio" rel="author" class="hover:text-ibm-blue-60 transition-colors">Stefano Capezzone</a>
          <span>•</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, lang)}
          </time>
          {post.data.updatedDate && (
            <>
              <span>•</span>
              <span>Aggiornato: {formatDate(post.data.updatedDate, lang)}</span>
            </>
          )}
        </div>
        <h1 class="text-3xl lg:text-4xl font-bold text-ibm-blue-90 mb-6">
          {post.data.title}
        </h1>
        <p class="text-xl text-ibm-blue-70 leading-relaxed">
          {post.data.description}
        </p>
        {post.data.tags && (
          <div class="flex flex-wrap gap-2 mt-6">
            {post.data.tags.map((tag) => (
              <span class="text-sm bg-ibm-blue-10 text-ibm-blue-60 px-3 py-1 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Featured Image -->
      {post.data.image && (
        <figure class="mb-12">
          <img
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            class="w-full rounded-xl shadow-lg"
            loading="eager"
          />
          {post.data.imageAlt && (
            <figcaption class="text-center text-sm text-ibm-blue-50 mt-3">
              {post.data.imageAlt}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Content -->
      <div class="prose prose-lg max-w-none prose-headings:text-ibm-blue-90 prose-p:text-ibm-blue-70 prose-strong:text-ibm-blue-80 prose-a:text-ibm-blue-60 prose-a:no-underline hover:prose-a:underline prose-code:text-ibm-blue-70 prose-code:bg-ibm-blue-10 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-ibm-blue-90 prose-blockquote:border-ibm-blue-60 prose-blockquote:text-ibm-blue-70">
        <Content />
      </div>

      <!-- Author Bio Box -->
      <aside class="mt-16 pt-8 border-t border-ibm-blue-20">
        <div class="flex items-start gap-4">
          <img
            src="/images/optimized/stefano-400.webp"
            alt="Stefano Capezzone"
            class="w-16 h-16 rounded-full object-cover"
            loading="lazy"
          />
          <div>
            <h3 class="font-semibold text-ibm-blue-90">
              <a href="/it/bio" rel="author" class="hover:text-ibm-blue-60 transition-colors">Stefano Capezzone</a>
            </h3>
            <p class="text-sm text-ibm-blue-70 mt-1">
              Imprenditore, docente e manager dell'innovazione. CEO di <a href="https://www.fastal.it/it/" class="text-ibm-blue-60 hover:underline" target="_blank" rel="noopener noreferrer">Fastal Srl</a>, Presidente Unione Comunicazione e Terziario <a href="https://cnaroma.it" class="text-ibm-blue-60 hover:underline" target="_blank" rel="noopener noreferrer">CNA Roma</a>.
            </p>
            <a href="/it/bio" class="text-sm text-ibm-blue-60 hover:text-ibm-blue-70 transition-colors mt-2 inline-block">
              Profilo completo &rarr;
            </a>
          </div>
        </div>
      </aside>

      <!-- Related Posts -->
      {relatedPosts.length > 0 && (
        <aside class="mt-12 pt-8 border-t border-ibm-blue-20">
          <h3 class="text-lg font-semibold text-ibm-blue-90 mb-6">Articoli correlati</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedPosts.map((rp) => (
              <a href={`/it/blog/${rp.slug.replace(/^it\//, '')}`} class="group block">
                {rp.data.image && (
                  <img src={rp.data.image} alt={rp.data.imageAlt || rp.data.title} class="w-full h-32 object-cover rounded-lg mb-3" loading="lazy" />
                )}
                <h4 class="font-medium text-ibm-blue-90 group-hover:text-ibm-blue-60 transition-colors">{rp.data.title}</h4>
                <time class="text-xs text-ibm-blue-50 mt-1 block" datetime={rp.data.pubDate.toISOString()}>
                  {formatDate(rp.data.pubDate, lang)}
                </time>
              </a>
            ))}
          </div>
        </aside>
      )}

      <!-- Publications Link -->
      <aside class="mt-8 p-4 bg-ibm-blue-10 rounded-lg">
        <p class="text-sm text-ibm-blue-70">
          Scopri le <a href="/it/pubblicazioni" class="text-ibm-blue-60 font-medium hover:underline">pubblicazioni scientifiche</a> di Stefano Capezzone su Intelligenza Artificiale e Quantum Computing.
        </p>
      </aside>

      <!-- Navigation -->
      <nav class="mt-8 pt-8 border-t border-ibm-blue-20">
        <a
          href="/it/blog"
          class="inline-flex items-center text-ibm-blue-60 hover:text-ibm-blue-70 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Torna al blog
        </a>
      </nav>
    </div>
  </article>
</BaseLayout>
