---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_LAUNCH_DATE } from '../../consts';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Abstract from '../../components/Abstract.astro';
import { t } from '../../i18n/utils';
import {
  displayJournal,
  doiUrl,
  getPublications,
  latestPublicationDate,
  publicationUrl,
  publicationYear,
  scholarlyArticleSchema,
} from '../../utils/publications';

const lang = 'en';

const sortedPublications = await getPublications();

const title = t(lang, 'publications.title');
const description = t(lang, 'publications.description');

const scholarlyArticlesSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Scientific publications by Stefano Capezzone",
  "itemListElement": sortedPublications.map((pub, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": scholarlyArticleSchema(pub, lang, Astro.site),
  }))
};

const breadcrumbItems = [
  { label: 'Home', href: '/en/' },
  { label: 'Publications' },
];
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  jsonLd={scholarlyArticlesSchema}
  datePublished={SITE_LAUNCH_DATE}
  dateModified={latestPublicationDate(sortedPublications)}
>
  <div class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} lang={lang} />

      <!-- Header -->
      <div class="mb-12">
        <h1 class="text-3xl lg:text-4xl font-bold text-ibm-blue-90 mb-4">
          {title}
        </h1>
        <p class="text-lg text-ibm-blue-70">
          {description}
        </p>
      </div>

      <!-- Publications List -->
      <div class="space-y-8">
        {sortedPublications.map((pub) => (
          <article class="bg-white rounded-xl shadow-sm border border-ibm-blue-20 p-6 lg:p-8">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
              <span class="inline-flex items-center px-3 py-1 bg-ibm-blue-60 text-white text-sm font-medium rounded-full">
                {publicationYear(pub)}
              </span>
              <a
                href={doiUrl(pub)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-sm text-ibm-blue-60 hover:text-ibm-blue-70 transition-colors"
              >
                DOI: {pub.doi}
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <h2 class="text-xl font-semibold text-ibm-blue-90 mb-2">
              <a
                href={publicationUrl(pub, lang)}
                class="hover:text-ibm-blue-60 transition-colors"
              >
                {pub.title}
              </a>
            </h2>

            <p class="text-ibm-blue-60 mb-4">
              <span class="font-medium">{displayJournal(pub)}</span>
            </p>

            {pub.authors && (
              <p class="text-sm text-ibm-blue-50 mb-4">
                {pub.authors.join(', ')}
              </p>
            )}

            {pub.abstract && (
              <details class="group">
                <summary class="cursor-pointer text-ibm-blue-60 hover:text-ibm-blue-70 transition-colors font-medium">
                  <span class="inline-flex items-center">
                    {t(lang, 'publications.abstract')}
                    <svg class="w-4 h-4 ml-1 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <Abstract abstract={pub.abstract} class="mt-4" />
              </details>
            )}

            <div class="mt-6">
              <a
                href={publicationUrl(pub, lang)}
                class="inline-flex items-center text-ibm-blue-60 font-medium hover:text-ibm-blue-70 transition-colors"
              >
                {t(lang, 'publications.viewPaper')} &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- ORCID Link -->
      <div class="mt-12 text-center">
        <a
          href="https://orcid.org/0009-0001-1857-5043"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 bg-ibm-blue-10 text-ibm-blue-70 rounded-lg hover:bg-ibm-blue-20 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"/>
          </svg>
          View full ORCID profile
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
