---
import sharp from 'sharp';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocalizedUrl, routePath } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogImage?: string;
  lang?: 'it' | 'en';
  canonicalURL?: string;
  jsonLd?: object | object[];
  ogType?: string;
  // Per le pagine che non sono un URL del sito ma una risposta a un URL
  // sbagliato (la 404). Oltre al noindex sopprime canonical e hreflang: sono
  // dichiarazioni sull'indirizzo della pagina, e la 404 viene servita su
  // indirizzi che non esistono.
  noindex?: boolean;
  datePublished?: string;
  dateModified?: string;
  articleMeta?: {
    publishedTime: string;
    modifiedTime: string;
    author: string;
    tags?: string[];
  };
  // Highwire Press tags. Lo standard descrive UN articolo per pagina: va
  // passato solo dalle pagine di dettaglio, mai da una pagina elenco.
  citationMeta?: {
    title: string;
    authors: string[];
    doi: string;
    journal: string;
    publicationDate: string;
  };
}

const {
  title,
  description,
  image,
  ogImage,
  lang = 'it',
  canonicalURL = Astro.url.href,
  jsonLd,
  ogType = 'website',
  noindex = false,
  datePublished,
  dateModified,
  articleMeta,
  citationMeta,
} = Astro.props;

const socialImage = ogImage || image || '/images/og-default.webp';

const siteName = 'Stefano Capezzone';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const socialImageURL = new URL(socialImage, Astro.site);

// og:image:width/height servono a chi rende l'anteprima *prima* di aver
// scaricato l'immagine: senza, la prima condivisione di un URL mostra spesso un
// riquadro vuoto o mal ritagliato, perché lo scraper non sa che forma aspettarsi.
// Misurate e non dichiarate: le OG del blog non hanno tutte la stessa forma, e
// un numero scritto a mano qui varrebbe per una sola di esse.
const { width: socialImageWidth, height: socialImageHeight } =
  await sharp(`public${socialImage}`).metadata();

const currentPath = Astro.url.pathname;
const hreflangIt = new URL(getLocalizedUrl(currentPath, 'it'), Astro.site).href;
const hreflangEn = new URL(getLocalizedUrl(currentPath, 'en'), Astro.site).href;

const personSchema = {
  "@type": "Person",
  "@id": "https://stefano.capezzone.it/#person",
  "name": "Stefano Capezzone",
  "givenName": "Stefano",
  "familyName": "Capezzone",
  "jobTitle": lang === 'it' ? "Imprenditore, Docente e Manager dell'Innovazione" : "Entrepreneur, Lecturer and Innovation Manager",
  "url": "https://stefano.capezzone.it",
  "image": "https://stefano.capezzone.it/images/optimized/stefano-square-960.webp",
  "description": lang === 'it'
    ? "Imprenditore, docente e manager dell'innovazione con oltre trent'anni di esperienza nel settore ICT e nell'Intelligenza Artificiale."
    : "Entrepreneur, lecturer and innovation manager with over thirty years of experience in ICT and Artificial Intelligence.",
  "sameAs": [
    "https://www.linkedin.com/in/stefano-capezzone/",
    "https://x.com/stefacap",
    "https://mastodon.social/@stefanocapezzone",
    "https://orcid.org/0009-0001-1857-5043",
    "https://www.facebook.com/stefano.capezzone/",
    "https://fablabs.io/users/blackparrot"
  ],
  "worksFor": [
    {
      "@type": "Organization",
      "name": "Fastal Srl",
      "url": "https://www.fastal.it"
    },
    {
      "@type": "Organization",
      "name": "CNA Roma",
      "url": "https://cnaroma.it"
    }
  ],
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Università La Sapienza di Roma"
  },
  "knowsAbout": [
    "Artificial Intelligence",
    "Software Engineering",
    "Cybersecurity",
    "Digital Transformation",
    "LLM",
    "Quantum Computing",
    "IoT",
    "Industry 4.0"
  ]
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": "https://stefano.capezzone.it/#website",
  "name": "Stefano Capezzone",
  "url": "https://stefano.capezzone.it",
  "inLanguage": ["it-IT", "en-US"],
  "publisher": { "@id": "https://stefano.capezzone.it/#person" }
};

const baseJsonLd = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema]
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? jsonLd : [jsonLd]
  : [];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Stefano Capezzone" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />

    <!-- Canonical URL -->
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="author" href={routePath('bio', lang)} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:site_name" content={siteName} />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:modified_time" content={articleMeta.modifiedTime} />
        <meta property="article:author" content={articleMeta.author} />
        {articleMeta.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@stefacap" />
    <meta name="twitter:creator" content="@stefacap" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- OG image dimensions -->
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta property="og:image:alt" content={title} />

    <!-- Dublin Core -->
    <meta name="DC.title" content={title} />
    <meta name="DC.creator" content="Stefano Capezzone" />
    <meta name="DC.description" content={description} />
    <meta name="DC.language" content={lang} />
    {datePublished && <meta name="DC.date" content={datePublished} />}
    {dateModified && <meta name="DC.date.modified" content={dateModified} />}

    <!-- Citation Meta Tags (Highwire Press / Google Scholar) -->
    {citationMeta && (
      <>
        <meta name="citation_title" content={citationMeta.title} />
        {citationMeta.authors.map((author) => (
          <meta name="citation_author" content={author} />
        ))}
        <meta name="citation_doi" content={citationMeta.doi} />
        <meta name="citation_journal_title" content={citationMeta.journal} />
        <meta name="citation_publication_date" content={citationMeta.publicationDate} />
      </>
    )}

    <!-- Alternate languages -->
    {!noindex && (
      <>
        <link rel="alternate" hreflang="it" href={hreflangIt} />
        <link rel="alternate" hreflang="en" href={hreflangEn} />
        <link rel="alternate" hreflang="x-default" href={hreflangIt} />
      </>
    )}

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Preconnect and DNS Prefetch for performance -->
    <link rel="dns-prefetch" href="https://doi.org" />
    <link rel="dns-prefetch" href="https://www.linkedin.com" />
    <link rel="dns-prefetch" href="https://orcid.org" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
    {allJsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-ibm-blue-90">
    <!-- Skip to content for accessibility -->
    <a href="#main-content" class="skip-to-content">
      {lang === 'it' ? 'Salta al contenuto' : 'Skip to content'}
    </a>

    <Header lang={lang} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
